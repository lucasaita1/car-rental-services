    {
      "name": "Users",
      "description": "CRUD de usuários. Só o register é público; o restante exige Bearer token.",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var body = pm.response.json();",
                  "if (body.id) {",
                  "    pm.collectionVariables.set('userId', body.id);",
                  "}",
                  "",
                  "pm.test('Senha nao retorna no corpo', function () {",
                  "    pm.expect(body).to.not.have.property('password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lucas Aita\",\n  \"email\": \"{{userEmail}}\",\n  \"cpf\": \"12345678901\",\n  \"cnh\": \"98765432100\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
