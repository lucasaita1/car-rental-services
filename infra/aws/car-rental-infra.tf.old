# =============================================================================
# car-rental-infra.tf.old — VERSÃO AWS (DESATIVADA)
# -----------------------------------------------------------------------------
# Adaptação do exemplo `streaming-infra.tf` da Aula 3 para o projeto
# car-rental-services. Mantém o conceito central pedido no enunciado:
# Load Balancer + Auto Scaling + Health Check.
#
# Por que está desativado (.old):
#   O Terraform só carrega arquivos terminados em `.tf`. Como o projeto não
#   usa uma conta AWS, este arquivo fica visível para a entrega, mas fora da
#   execução do pipeline. Para subir de verdade na AWS, renomeie para
#   `car-rental-infra.tf` e rode:
#
#       terraform init && terraform plan && terraform apply
#
# ATENÇÃO: cria recursos reais e gera custo (o ALB cobra por hora). Use uma
# conta de estudos e rode `terraform destroy` ao terminar.
#
# Observação: o microsserviço de e-mail não expõe HTTP (é consumidor AMQP),
# então ele não entra no balanceador — apenas os serviços user (8081) e
# car (8082) são publicados.
# =============================================================================

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
}

# -----------------------------------------------------------------------------
# Variáveis
# -----------------------------------------------------------------------------
variable "aws_region" {
  description = "Região da AWS onde a infraestrutura será criada"
  type        = string
  default     = "us-east-1"
}

variable "instance_type" {
  description = "Tipo das instâncias que rodam os microsserviços"
  type        = string
  default     = "t3.micro"
}

# -----------------------------------------------------------------------------
# Data sources
# -----------------------------------------------------------------------------
# Busca a AMI mais recente do Amazon Linux 2023 em vez de fixar um ID
# que fica desatualizado com o tempo.
data "aws_ami" "amazon_linux" {
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["al2023-ami-*-x86_64"]
  }
}

# Usa a VPC padrão da conta para não complicar a aula com rede.
data "aws_vpc" "default" {
  default = true
}

data "aws_subnets" "default" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.default.id]
  }
}

# -----------------------------------------------------------------------------
# Security Groups
# -----------------------------------------------------------------------------
# SG do balanceador: recebe HTTP da internet.
resource "aws_security_group" "alb_sg" {
  name        = "car-rental-alb-sg"
  description = "Permite trafego HTTP publico para o balanceador"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description = "HTTP publico"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

# SG das instâncias: só aceita tráfego vindo do balanceador, nas portas
# dos microsserviços (8081 user, 8082 car).
resource "aws_security_group" "app_sg" {
  name        = "car-rental-app-sg"
  description = "Permite trafego do ALB para os microsservicos"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description     = "user-microservice"
    from_port       = 8081
    to_port         = 8081
    protocol        = "tcp"
    security_groups = [aws_security_group.alb_sg.id]
  }

  ingress {
    description     = "car-microservice"
    from_port       = 8082
    to_port         = 8082
    protocol        = "tcp"
    security_groups = [aws_security_group.alb_sg.id]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

# -----------------------------------------------------------------------------
# Launch Template — receita de como cada servidor nasce
# -----------------------------------------------------------------------------
resource "aws_launch_template" "car_rental_server" {
  name_prefix   = "car-rental-server-"
  image_id      = data.aws_ami.amazon_linux.id
  instance_type = var.instance_type

  vpc_security_group_ids = [aws_security_group.app_sg.id]

  # Sobe os containers da aplicação na primeira inicialização.
  # Os segredos (.env) devem vir de um cofre real (SSM Parameter Store /
  # Secrets Manager); aqui o script apenas prepara o ambiente Docker.
  user_data = base64encode(<<-EOF
    #!/bin/bash
    set -euo pipefail
    dnf update -y
    dnf install -y docker git
    systemctl enable --now docker
    usermod -aG docker ec2-user
    mkdir -p /usr/local/lib/docker/cli-plugins
    curl -SL https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64 \
      -o /usr/local/lib/docker/cli-plugins/docker-compose
    chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
    git clone https://github.com/lucasaita1/car-rental-services.git /opt/car-rental-services
    cd /opt/car-rental-services
    docker compose up -d
    EOF
  )
}

# -----------------------------------------------------------------------------
# Load Balancer (ALB)
# -----------------------------------------------------------------------------
resource "aws_lb" "car_rental_lb" {
  name               = "car-rental-lb"
  internal           = false
  load_balancer_type = "application"
  security_groups    = [aws_security_group.alb_sg.id]
  subnets            = data.aws_subnets.default.ids
}

# Target group do user-microservice (porta 8081).
# O matcher aceita 403 porque GET /users exige JWT; ainda assim prova que a
# aplicação está no ar.
resource "aws_lb_target_group" "user_tg" {
  name     = "car-rental-user-tg"
  port     = 8081
  protocol = "HTTP"
  vpc_id   = data.aws_vpc.default.id

  health_check {
    path                = "/users"
    matcher             = "200-403"
    interval            = 15
    healthy_threshold   = 2
    unhealthy_threshold = 2
  }
}

# Target group do car-microservice (porta 8082).
resource "aws_lb_target_group" "car_tg" {
  name     = "car-rental-car-tg"
  port     = 8082
  protocol = "HTTP"
  vpc_id   = data.aws_vpc.default.id

  health_check {
    path                = "/cars"
    interval            = 15
    healthy_threshold   = 2
    unhealthy_threshold = 2
  }
}

# Listener: porta 80. Por padrão envia tudo para o car-microservice; a
# regra abaixo desvia as rotas de autenticação/usuários para o user-service.
resource "aws_lb_listener" "car_rental_listener" {
  load_balancer_arn = aws_lb.car_rental_lb.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.car_tg.arn
  }
}

resource "aws_lb_listener_rule" "user_routes" {
  listener_arn = aws_lb_listener.car_rental_listener.arn
  priority     = 10

  action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.user_tg.arn
  }

  condition {
    path_pattern {
      values = ["/users*", "/auth*"]
    }
  }
}

# -----------------------------------------------------------------------------
# Auto Scaling Group
# -----------------------------------------------------------------------------
resource "aws_autoscaling_group" "car_rental_asg" {
  name                = "car-rental-asg"
  min_size            = 2
  max_size            = 4
  desired_capacity    = 2
  vpc_zone_identifier = data.aws_subnets.default.ids
  target_group_arns   = [aws_lb_target_group.user_tg.arn, aws_lb_target_group.car_tg.arn]
  health_check_type   = "ELB"

  launch_template {
    id      = aws_launch_template.car_rental_server.id
    version = "$Latest"
  }

  tag {
    key                 = "Name"
    value               = "car-rental-server"
    propagate_at_launch = true
  }
}

# -----------------------------------------------------------------------------
# Saídas
# -----------------------------------------------------------------------------
output "car_rental_url" {
  description = "URL publica do balanceador de carga"
  value       = "http://${aws_lb.car_rental_lb.dns_name}"
}
