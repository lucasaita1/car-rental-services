# MongoDB
MONGODB_URI=mongodb://localhost:27017/email-service

# RabbitMQ
RABBITMQ_ADDRESSES=amqp://guest:guest@localhost:5672/
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=localhost
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_SSL=false

# SMTP (Gmail exige senha de app; sem aspas mesmo com espaços)
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
